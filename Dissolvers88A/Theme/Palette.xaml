<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- DISSOLVERS design system (matches the Windows Dissolvers app). -->

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <sys:Double x:Key="RadiusCard">14</sys:Double>

    <Color x:Key="C.Accent">#2563EB</Color>
    <Color x:Key="C.AccentDark">#1E40AF</Color>
    <Color x:Key="C.Navy">#0F172A</Color>

    <LinearGradientBrush x:Key="Brush.AppBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#BAE6FD" Offset="0.0" />
        <GradientStop Color="#C7D2FE" Offset="0.32" />
        <GradientStop Color="#E9D5FF" Offset="0.62" />
        <GradientStop Color="#F3E8FF" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Panel"        Color="#E7F0FF" />
    <SolidColorBrush x:Key="Brush.Card"         Color="#EDF5FF" />
    <SolidColorBrush x:Key="Brush.Input"        Color="#F7FAFF" />
    <SolidColorBrush x:Key="Brush.KeyNumber"    Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.KeyFunction"  Color="#EAF1FF" />
    <SolidColorBrush x:Key="Brush.AccentSoft"   Color="#DBEAFE" />
    <SolidColorBrush x:Key="Brush.Accent"       Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.AccentDark"   Color="#1E40AF" />
    <SolidColorBrush x:Key="Brush.Teal"         Color="#0F766E" />
    <SolidColorBrush x:Key="Brush.Purple"       Color="#7C3AED" />
    <SolidColorBrush x:Key="Brush.Danger"       Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.DangerSoft"   Color="#FEE2E2" />
    <SolidColorBrush x:Key="Brush.Amber"        Color="#D97706" />
    <SolidColorBrush x:Key="Brush.AmberSoft"    Color="#FEF3C7" />

    <SolidColorBrush x:Key="Brush.Navy"         Color="#0F172A" />
    <SolidColorBrush x:Key="Brush.NavyPanel"    Color="#111A2E" />

    <SolidColorBrush x:Key="Brush.Text"         Color="#0F172A" />
    <SolidColorBrush x:Key="Brush.TextSecond"   Color="#334155" />
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#475569" />
    <SolidColorBrush x:Key="Brush.TextFaint"    Color="#94A3B8" />
    <SolidColorBrush x:Key="Brush.LabelCaps"    Color="#64748B" />
    <SolidColorBrush x:Key="Brush.Border"       Color="#CBD5E1" />

    <SolidColorBrush x:Key="Brush.DisplayText"  Color="#F8FAFF" />
    <SolidColorBrush x:Key="Brush.DisplayMuted" Color="#94A9C9" />
    <SolidColorBrush x:Key="Brush.DisplayGrid"  Color="#1E2A45" />

    <!-- graph curve colours (Y1..Y6) -->
    <Color x:Key="C.Y1">#2563EB</Color>
    <Color x:Key="C.Y2">#DC2626</Color>
    <Color x:Key="C.Y3">#0F766E</Color>
    <Color x:Key="C.Y4">#7C3AED</Color>
    <Color x:Key="C.Y5">#D97706</Color>
    <Color x:Key="C.Y6">#DB2777</Color>

    <FontFamily x:Key="Font.Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas, Cascadia Mono, Segoe UI</FontFamily>

</ResourceDictionary>
