<UserControl x:Class="Dissolvers88A.Views.RView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Dissolvers88A.ViewModels"
             xmlns:r="clr-namespace:Dissolvers88A.R"
             FontFamily="{StaticResource Font.Ui}">

    <UserControl.Resources>
        <vm:RKindToBrushConverter x:Key="KindBrush" />

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.Card}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecond}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="1.05*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- ===== console ===== -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Navy}" CornerRadius="14">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,12,14,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="R CONSOLE" Foreground="{StaticResource Brush.DisplayMuted}"
                                   FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="{Binding HeaderText}" Foreground="{StaticResource Brush.DisplayMuted}"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Brush.DisplayMuted}"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="clear" Style="{StaticResource ToolButton}" Margin="0"
                                Padding="8,3" FontSize="11" Command="{Binding ClearLogCommand}" />
                    </StackPanel>
                </Grid>

                <!-- input row -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.NavyPanel}"
                        BorderBrush="#24324F" BorderThickness="0,1,0,0">
                    <Grid Margin="10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&gt;" Foreground="#38BDF8" FontFamily="{StaticResource Font.Mono}"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,8,0" />
                        <TextBox x:Name="Input" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Brush.DisplayText}" CaretBrush="#38BDF8"
                                 FontFamily="{StaticResource Font.Mono}" FontSize="13" VerticalContentAlignment="Center"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding Ready}" KeyDown="Input_KeyDown" />
                        <Button Grid.Column="2" Content="Run" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                Background="{StaticResource Brush.Accent}" Foreground="White"
                                Command="{Binding RunCommand}" />
                    </Grid>
                </Border>

                <!-- transcript -->
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="14,4,14,10">
                    <ItemsControl x:Name="Log" ItemsSource="{Binding Console}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="12.5"
                                           Foreground="{Binding Kind, Converter={StaticResource KindBrush}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== plot screen + data bridge ===== -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Panel}" CornerRadius="14"
                    Padding="12,10" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="DATA BRIDGE" Style="{StaticResource CapsLabel}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Sync L1–L6 → R" Style="{StaticResource ToolButton}"
                                Command="{Binding PushListsCommand}" />
                        <TextBlock Text="pushes the Stats lists into R as L1…L6" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="pull" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}"
                                   FontSize="12" Margin="0,0,6,0" />
                        <TextBox Width="150" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                 VerticalContentAlignment="Center" Padding="6,3"
                                 Background="{StaticResource Brush.Input}" BorderBrush="{StaticResource Brush.Border}"
                                 BorderThickness="1" Text="{Binding PullExpression, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="→" VerticalAlignment="Center" Margin="8,0,8,0"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <ComboBox x:Name="PullTarget" Width="64" SelectedIndex="{Binding PullTargetIndex}" />
                        <Button Content="Pull" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                Command="{Binding PullCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Brush.Navy}" CornerRadius="14"
                    BorderBrush="{StaticResource Brush.Navy}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="R plots render here" Foreground="#4B5D80"
                               FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding NoPlots, Converter={StaticResource BoolToVis}}" />

                    <Border Background="White" Margin="10"
                            Visibility="{Binding HasPlots, Converter={StaticResource BoolToVis}}">
                        <Image Source="{Binding CurrentPlot}" Stretch="Uniform" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="14" Visibility="{Binding HasPlots, Converter={StaticResource BoolToVis}}">
                        <Button Content="‹" Style="{StaticResource ToolButton}" Padding="10,3"
                                Command="{Binding PrevPlotCommand}" />
                        <Border Background="#0D1627CC" CornerRadius="7" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock Text="{Binding PlotCounter}" Foreground="#8CA0C4"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="11" />
                        </Border>
                        <Button Content="›" Style="{StaticResource ToolButton}" Padding="10,3" Margin="0"
                                Command="{Binding NextPlotCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>

        <!-- ===== R-not-installed overlay ===== -->
        <Border x:Name="Unavailable" Grid.ColumnSpan="3" Background="#F2F5FF" CornerRadius="14"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <TextBlock Text="R is not installed on this PC" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource Brush.Navy}" HorizontalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,16"
                           Foreground="{StaticResource Brush.TextMuted}" FontSize="13"
                           Text="The R tab drives a real R session on your machine. Install R (free, from CRAN), then reopen DISSOLVERS 88A." />
                <TextBlock HorizontalAlignment="Center">
                    <Hyperlink x:Name="CranLink" RequestNavigate="Cran_Navigate" NavigateUri="https://cran.r-project.org/bin/windows/base/">
                        <Run Text="Download R for Windows →" FontWeight="SemiBold" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
