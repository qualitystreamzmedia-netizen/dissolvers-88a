<UserControl x:Class="Dissolvers88A.Views.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="500" />
        </Grid.ColumnDefinitions>

        <!-- ===== display + history ===== -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Navy}" CornerRadius="14" Padding="20,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="HistoryScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding Expression}" TextAlignment="Right"
                                               Foreground="{StaticResource Brush.DisplayMuted}"
                                               FontFamily="{StaticResource Font.Mono}" FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               MouseLeftButtonUp="History_ExprClick" Cursor="Hand" />
                                    <TextBlock Text="{Binding Result}" TextAlignment="Right"
                                               FontFamily="{StaticResource Font.Mono}" FontSize="17"
                                               MouseLeftButtonUp="History_ResultClick" Cursor="Hand">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.DisplayText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="#FCA5A5" />
                                                        <Setter Property="FontSize" Value="13" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBox x:Name="InputBox" Grid.Row="1" Margin="0,10,0,0"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.DisplayText}"
                         CaretBrush="{StaticResource Brush.DisplayText}" FontFamily="{StaticResource Font.Mono}"
                         FontSize="30" TextAlignment="Right" AcceptsReturn="False" MaxLines="1"
                         SelectionBrush="{StaticResource Brush.Accent}"
                         TextChanged="InputBox_TextChanged" PreviewKeyDown="InputBox_PreviewKeyDown" />

                <TextBlock x:Name="PreviewText" Grid.Row="2" Text="{Binding Preview}" TextAlignment="Right"
                           Foreground="{StaticResource Brush.DisplayMuted}"
                           FontFamily="{StaticResource Font.Mono}" FontSize="16" Margin="0,4,0,0" />

                <Border Grid.Row="3" Margin="0,14,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource Brush.DisplayGrid}">
                    <Grid>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.DisplayMuted}" FontSize="12" />
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource Brush.DisplayMuted}" FontSize="12">
                            <Run Text="Ans " /><Run Text="{Binding AnsDisplay, Mode=OneWay}"
                                                    Foreground="{StaticResource Brush.DisplayText}" />
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===== keypad ===== -->
        <Border Grid.Column="2" Background="{StaticResource Brush.Panel}" CornerRadius="14" Padding="8">
            <Grid x:Name="Keypad">
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- row 0 -->
                <ToggleButton x:Name="SecondKey" Grid.Row="0" Grid.Column="0" Style="{StaticResource Key.Toggle}"
                              Content="2nd" Click="Second_Click" />
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource Key.Function}" Tag="(" Content="(" Click="KeyClick" />
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Key.Function}" Tag=")" Content=")" Click="KeyClick" />
                <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource Key.Function}" Tag="X" Content="X" Click="KeyClick" />
                <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource Key.Danger}" Tag="DEL" Content="DEL" Click="KeyClick" />

                <!-- row 1 -->
                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource Key.Function}" Tag="sin(" Click="KeyClick">
                    <StackPanel><TextBlock Text="sin⁻¹" FontSize="9" Foreground="{StaticResource Brush.Amber}" HorizontalAlignment="Center" /><TextBlock Text="sin" HorizontalAlignment="Center" /></StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Key.Function}" Tag="cos(" Click="KeyClick">
                    <StackPanel><TextBlock Text="cos⁻¹" FontSize="9" Foreground="{StaticResource Brush.Amber}" HorizontalAlignment="Center" /><TextBlock Text="cos" HorizontalAlignment="Center" /></StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Key.Function}" Tag="tan(" Click="KeyClick">
                    <StackPanel><TextBlock Text="tan⁻¹" FontSize="9" Foreground="{StaticResource Brush.Amber}" HorizontalAlignment="Center" /><TextBlock Text="tan" HorizontalAlignment="Center" /></StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource Key.Operator}" Tag="^" Click="KeyClick">
                    <StackPanel><TextBlock Text="nPr" FontSize="9" Foreground="{StaticResource Brush.Amber}" HorizontalAlignment="Center" /><TextBlock Text="^" HorizontalAlignment="Center" /></StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="4" Style="{StaticResource Key.Danger}" Tag="AC" Content="AC" Click="KeyClick" />

                <!-- row 2 -->
                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource Key.Function}" Tag="sqrt(" Click="KeyClick">
                    <StackPanel><TextBlock Text="∛" FontSize="9" Foreground="{StaticResource Brush.Amber}" HorizontalAlignment="Center" /><TextBlock Text="√" HorizontalAlignment="Center" /></StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource Key.Function}" Tag="^2" Click="KeyClick">
                    <StackPanel><TextBlock Text="x³" FontSize="9" Foreground="{StaticResource Brush.Amber}" HorizontalAlignment="Center" /><TextBlock Text="x²" HorizontalAlignment="Center" /></StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Key.Function}" Tag="^-1" Click="KeyClick">
                    <StackPanel><TextBlock Text="|x|" FontSize="9" Foreground="{StaticResource Brush.Amber}" HorizontalAlignment="Center" /><TextBlock Text="x⁻¹" HorizontalAlignment="Center" /></StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource Key.Function}" Tag="!" Click="KeyClick">
                    <StackPanel><TextBlock Text="nCr" FontSize="9" Foreground="{StaticResource Brush.Amber}" HorizontalAlignment="Center" /><TextBlock Text="!" HorizontalAlignment="Center" /></StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource Key.Operator}" Tag="/" Content="÷" Click="KeyClick" />

                <!-- row 3 -->
                <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource Key.Function}" Tag="ln(" Click="KeyClick">
                    <StackPanel><TextBlock Text="eˣ" FontSize="9" Foreground="{StaticResource Brush.Amber}" HorizontalAlignment="Center" /><TextBlock Text="ln" HorizontalAlignment="Center" /></StackPanel>
                </Button>
                <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource Key.Function}" Tag="log(" Click="KeyClick">
                    <StackPanel><TextBlock Text="10ˣ" FontSize="9" Foreground="{StaticResource Brush.Amber}" HorizontalAlignment="Center" /><TextBlock Text="log" HorizontalAlignment="Center" /></StackPanel>
                </Button>
                <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource Key.Function}" Tag="E" Content="EE" Click="KeyClick" />
                <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource Key.Function}" Tag="π" Content="π" Click="KeyClick" />
                <Button Grid.Row="3" Grid.Column="4" Style="{StaticResource Key.Operator}" Tag="*" Content="×" Click="KeyClick" />

                <!-- row 4 -->
                <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource Key.Digit}" Tag="7" Content="7" Click="KeyClick" />
                <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource Key.Digit}" Tag="8" Content="8" Click="KeyClick" />
                <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource Key.Digit}" Tag="9" Content="9" Click="KeyClick" />
                <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource Key.Function}" Tag="e" Content="e" Click="KeyClick" />
                <Button Grid.Row="4" Grid.Column="4" Style="{StaticResource Key.Operator}" Tag="-" Content="−" Click="KeyClick" />

                <!-- row 5 -->
                <Button Grid.Row="5" Grid.Column="0" Style="{StaticResource Key.Digit}" Tag="4" Content="4" Click="KeyClick" />
                <Button Grid.Row="5" Grid.Column="1" Style="{StaticResource Key.Digit}" Tag="5" Content="5" Click="KeyClick" />
                <Button Grid.Row="5" Grid.Column="2" Style="{StaticResource Key.Digit}" Tag="6" Content="6" Click="KeyClick" />
                <Button Grid.Row="5" Grid.Column="3" Style="{StaticResource Key.Function}" Tag="," Content="," Click="KeyClick" />
                <Button Grid.Row="5" Grid.Column="4" Style="{StaticResource Key.Operator}" Tag="+" Content="+" Click="KeyClick" />

                <!-- row 6-7 -->
                <Button Grid.Row="6" Grid.Column="0" Style="{StaticResource Key.Digit}" Tag="1" Content="1" Click="KeyClick" />
                <Button Grid.Row="6" Grid.Column="1" Style="{StaticResource Key.Digit}" Tag="2" Content="2" Click="KeyClick" />
                <Button Grid.Row="6" Grid.Column="2" Style="{StaticResource Key.Digit}" Tag="3" Content="3" Click="KeyClick" />
                <Button Grid.Row="6" Grid.Column="3" Style="{StaticResource Key.Function}" Tag="→" Content="STO→" Click="KeyClick" />
                <Button Grid.Row="6" Grid.Column="4" Grid.RowSpan="2" Style="{StaticResource Key.Accent}" Tag="EVAL" Content="=" Click="KeyClick" />

                <Button Grid.Row="7" Grid.Column="0" Style="{StaticResource Key.Digit}" Tag="0" Content="0" Click="KeyClick" />
                <Button Grid.Row="7" Grid.Column="1" Style="{StaticResource Key.Digit}" Tag="." Content="." Click="KeyClick" />
                <Button Grid.Row="7" Grid.Column="2" Style="{StaticResource Key.Digit}" Tag="NEG" Content="(-)" Click="KeyClick" />
                <Button Grid.Row="7" Grid.Column="3" Style="{StaticResource Key.Function}" Tag="Ans" Content="Ans" Click="KeyClick" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
