<Window x:Class="Dissolvers88A.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Dissolvers88A.Views"
        Title="DISSOLVERS 88A" Height="760" Width="1140" MinHeight="640" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Ui}"
        Background="{StaticResource Brush.AppBackground}">

    <Grid Margin="18,16,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== header ===== -->
        <Grid Grid.Row="0" Margin="2,0,2,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DISSOLVERS" FontSize="19" FontWeight="Bold"
                           Foreground="{StaticResource Brush.Navy}" VerticalAlignment="Center" />
                <Border Background="{StaticResource Brush.Accent}" CornerRadius="6"
                        Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="88A" Foreground="White" FontWeight="Bold" FontSize="12" />
                </Border>
                <TextBlock Text="graphing calculator" Foreground="{StaticResource Brush.TextMuted}"
                           FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton x:Name="TabCalc" Style="{StaticResource ModeTab}" Content="Calculate"
                             IsChecked="True" Checked="Tab_Checked" />
                <RadioButton x:Name="TabGraph" Style="{StaticResource ModeTab}" Content="Graph"
                             Checked="Tab_Checked" />
                <RadioButton x:Name="TabStats" Style="{StaticResource ModeTab}" Content="Stats"
                             Checked="Tab_Checked" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="ANGLE" Style="{StaticResource CapsLabel}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <RadioButton x:Name="AngleRad" GroupName="angle" Style="{StaticResource Chip}"
                             Content="RAD" IsChecked="True" Checked="Angle_Checked" Margin="0,0,6,0" />
                <RadioButton x:Name="AngleDeg" GroupName="angle" Style="{StaticResource Chip}"
                             Content="DEG" Checked="Angle_Checked" />
            </StackPanel>
        </Grid>

        <!-- ===== body ===== -->
        <Grid Grid.Row="1">
            <views:CalculatorView x:Name="CalcView" />
            <views:GrapherView x:Name="GraphView" Visibility="Collapsed" />
            <views:StatsView x:Name="StatsView" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
