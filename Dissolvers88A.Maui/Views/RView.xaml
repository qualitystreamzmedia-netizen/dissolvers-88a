<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dissolvers88A.Maui.Views.RView">

    <Grid>
        <WebView x:Name="Web" Navigating="OnNavigating" />

        <Label x:Name="Hint" Text="Starting R (WebAssembly)…  first run downloads nothing — it's bundled, but the engine takes a few seconds to warm up."
               IsVisible="True" Margin="24" FontSize="13" LineBreakMode="WordWrap"
               HorizontalTextAlignment="Center" VerticalOptions="Center"
               TextColor="{StaticResource D.TextMuted}" />
    </Grid>
</ContentView>
